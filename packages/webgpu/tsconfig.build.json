{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"noEmitOnError": true,
		"declaration": true,
		"removeComments": false,
		"sourceMap": true,
		"inlineSources": true,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"include": ["src/**/*"],
	"exclude": ["tests/**/*", "benchmarks/**/*"]
}
