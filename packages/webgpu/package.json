{
  "name": "@zenfg/webgpu",
  "version": "0.2.0",
  "description": "A standalone FrameGraph compiler and transient-resource runtime for WebGPU",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs",
    "skills"
  ],
  "dependencies": {
    "@zenfg/snapshot": "workspace:0.1.1"
  },
  "scripts": {
    "benchmark:compile": "node ../../scripts/run-webgpu-compile-benchmark.mjs",
    "build": "node ../../scripts/build-package.mjs",
    "build:watch": "node ../../scripts/build-package.mjs --watch",
    "prepack": "node ../../scripts/docs/i18n.mjs check --package && node ../../scripts/docs/skills.mjs --check --package && pnpm -r --filter \"@zenfg/webgpu...\" run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/run-tests.mjs packages/webgpu/tests",
    "pack": "pnpm pack --json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uinosoft/zenfg.git",
    "directory": "packages/webgpu"
  },
  "homepage": "https://uinosoft.github.io/zenfg/docs/packages/webgpu.html",
  "bugs": {
    "url": "https://github.com/uinosoft/zenfg/issues"
  },
  "keywords": [
    "webgpu",
    "framegraph",
    "rendering",
    "graphics"
  ]
}
