{
  "name": "@zenfg/inspector",
  "version": "0.2.0",
  "description": "Embeddable Inspector for ZenFG Snapshot files and live captures",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./themes.css": "./dist/themes.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "THEMING.md",
    "GUIDE.md"
  ],
  "dependencies": {
    "@zenfg/snapshot": "workspace:0.1.1",
    "cytoscape": "^3.34.1",
    "elkjs": "^0.12.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "build:watch": "node ../../scripts/build-package.mjs --watch",
    "prepack": "pnpm -r --filter \"@zenfg/inspector...\" run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/run-tests.mjs packages/inspector/tests",
    "pack": "pnpm pack --json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uinosoft/zenfg.git",
    "directory": "packages/inspector"
  },
  "homepage": "https://uinosoft.github.io/zenfg/docs/packages/inspector.html",
  "bugs": {
    "url": "https://github.com/uinosoft/zenfg/issues"
  },
  "keywords": [
    "framegraph",
    "inspector",
    "webgpu",
    "wgpu",
    "diagnostics"
  ]
}
