{
  "name": "zenfg-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.11.0 <12"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "packages/*",
    "apps/site",
    "apps/docs"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace @zenfg/snapshot && npm run build --workspace @zenfg/webgpu && npm run build --workspace @zenfg/inspector",
    "build:site": "node scripts/docs/build-site.mjs",
    "build": "npm run build:packages && npm run build:site",
    "build:pages": "npm run build:site",
    "preview:pages": "npm run build:pages && npm run preview --workspace @zenfg/site-app -- --base /zenfg/",
    "benchmark:webgpu": "npm run benchmark:compile --workspace @zenfg/webgpu --",
    "cargo:package-check": "node ./scripts/check-cargo-packages.mjs",
    "cargo:release-check": "node ./scripts/check-cargo-release.mjs",
    "dev": "node scripts/docs/dev.mjs",
    "docs:check": "node scripts/docs/sync.mjs --check && node scripts/check-public-docs.mjs && node scripts/docs/check.mjs",
    "test:cross-language": "npm run build:packages && node ./scripts/run-cross-language-conformance.mjs",
    "typecheck:examples": "tsc --noEmit -p packages/webgpu/examples/tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p scripts/tsconfig.tests.json",
    "typecheck": "npm run typecheck:tests && npm run build:packages && npm run typecheck:examples && npm run typecheck --workspace @zenfg/site-app && npm run typecheck --workspace @zenfg/snapshot && npm run typecheck --workspace @zenfg/webgpu && npm run typecheck --workspace @zenfg/inspector && npm run typecheck --workspace @zenfg/docs-app",
    "test": "node ./scripts/run-tests.mjs",
    "pack:check": "node ./scripts/check-packages.mjs",
    "docs:generate": "node scripts/docs/sync.mjs",
    "docs:prepare": "node scripts/docs/prepare.mjs",
    "docs:build": "npm run build --workspace @zenfg/docs-app",
    "dev:docs": "npm run dev --workspace @zenfg/docs-app",
    "docs:test": "node --test scripts/docs/tests/*.test.mjs",
    "docs:test:browser": "node scripts/docs/browser-check.mjs",
    "release": "node scripts/release/run.mjs",
    "release:check": "node scripts/release/run.mjs static",
    "release:test": "node --test scripts/release/tests/*.test.mjs",
    "release:smoke:npm": "node scripts/release/smoke.mjs npm",
    "release:smoke:cargo": "node scripts/release/smoke.mjs cargo",
    "release:smoke": "node scripts/release/smoke.mjs all"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.69",
    "esbuild": "^0.28.0",
    "github-slugger": "2.0.0",
    "happy-dom": "^20.11.2",
    "markdown-it": "15.0.2",
    "playwright": "1.63.0",
    "smol-toml": "1.8.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
