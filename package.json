{
  "name": "zenfg-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.11.2 <13"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "brand:build": "node scripts/build-brand.mjs",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "build:site": "node scripts/docs/build-site.mjs",
    "build": "pnpm run build:packages && pnpm run build:site",
    "build:pages": "pnpm run build:site",
    "preview:pages": "pnpm run build:pages && pnpm --filter @zenfg/site-app run preview --base /zenfg/",
    "benchmark:webgpu": "pnpm --filter @zenfg/webgpu run benchmark:compile",
    "cargo:package-check": "node ./scripts/check-cargo-packages.mjs",
    "cargo:release-check": "node ./scripts/check-cargo-release.mjs",
    "dev": "node scripts/docs/dev.mjs",
    "docs:check": "node scripts/docs/sync.mjs --check && node scripts/docs/skills.mjs --check && node scripts/docs/i18n.mjs check && node scripts/check-public-docs.mjs && node scripts/docs/check.mjs",
    "test:cross-language": "pnpm run build:packages && node ./scripts/run-cross-language-conformance.mjs",
    "typecheck:examples": "tsc --noEmit -p packages/webgpu/examples/tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p scripts/tsconfig.tests.json",
    "typecheck": "pnpm run typecheck:tests && pnpm run build:packages && pnpm run typecheck:examples && pnpm -r run typecheck",
    "test": "node ./scripts/run-tests.mjs",
    "pack:check": "node ./scripts/check-packages.mjs",
    "docs:generate": "node scripts/docs/sync.mjs && node scripts/docs/skills.mjs",
    "docs:i18n:status": "node scripts/docs/i18n.mjs status",
    "docs:i18n:check": "node scripts/docs/i18n.mjs check",
    "docs:i18n:seed": "node scripts/docs/i18n.mjs seed",
    "docs:i18n:accept": "node scripts/docs/i18n.mjs accept",
    "docs:prepare": "node scripts/docs/prepare.mjs",
    "docs:build": "pnpm --filter @zenfg/docs-app run build",
    "dev:docs": "pnpm --filter @zenfg/docs-app run dev",
    "docs:test": "node --test scripts/docs/tests/*.test.mjs",
    "docs:test:browser": "node scripts/docs/browser-check.mjs",
    "release": "node scripts/release/run.mjs",
    "release:check": "node scripts/release/run.mjs static",
    "release:test": "node --test scripts/release/tests/*.test.mjs",
    "release:smoke:npm": "node scripts/release/smoke.mjs npm",
    "release:smoke:cargo": "node scripts/release/smoke.mjs cargo",
    "release:smoke": "node scripts/release/smoke.mjs all",
    "release:assess": "node scripts/release/assess.mjs",
    "brand:social": "node scripts/build-social.mjs",
    "showcase:capture": "node scripts/capture-showcase.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.69",
    "@zenfg/snapshot": "workspace:0.1.1",
    "esbuild": "^0.28.0",
    "github-slugger": "2.0.0",
    "happy-dom": "^20.11.2",
    "markdown-it": "15.0.2",
    "npm": "11.11.0",
    "playwright": "1.63.0",
    "smol-toml": "1.8.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typedoc-vitepress-theme": "1.1.4",
    "typegpu": "0.12.5",
    "typescript": "^6.0.3",
    "unplugin-typegpu": "0.12.3",
    "vite": "^8.0.11",
    "vitepress": "1.6.4"
  }
}
