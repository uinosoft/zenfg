{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "@webgpu/types", "node"],
		"paths": {
			"@zenfg/snapshot": ["../../packages/snapshot/src/index.ts"],
			"@zenfg/snapshot/format": ["../../packages/snapshot/src/format.ts"],
			"@zenfg/webgpu": ["../../packages/webgpu/src/index.ts"],
			"@zenfg/webgpu/snapshot": ["../../packages/webgpu/src/snapshot.ts"],
			"@zenfg/inspector": ["../../packages/inspector/src/index.ts"],
			"@zenfg/inspector/theme": ["../../packages/inspector/src/theme.ts"]
		}
	},
	"include": [
		"src/**/*",
		"shared/**/*",
		"inspector/src/**/*",
		"playground/src/**/*",
		"examples/*/src/**/*",
		"vite.config.ts",
		"tests/**/*.ts",
		"inspector/tests/**/*.ts",
		"playground/tests/**/*.ts",
		"examples/*/tests/**/*.ts"
	],
	"exclude": [
		"**/tests/browser/**",
		"**/tests/gpu/**"
	]
}
